Import("env")

from pathlib import Path
import json
import subprocess
from opendbc import prepare_native_dbc_generator, run_dbc_generator

generator = File(str(prepare_native_dbc_generator()))
source_root = Path("generator").resolve()
output_root = Path.cwd()

source_files = [
  File(str(f))
  for f in Path("generator").rglob("*")
  if f.is_file() and f.suffix in {".py", ".dbc"}
]

output_files = [
  f.name.replace(".dbc", "_generated.dbc")
  for f in Path("generator").rglob("*.dbc")
  if not f.name.startswith("_")
]

# Native procedural programs remain registered after their Python sources retire.
output_files += json.loads(run_dbc_generator("program-outputs"))


def generate_native_dbcs(target, source, env):
  subprocess.check_call([generator.abspath, "create-all", str(output_root),
                         "--source", str(source_root), "--all-programs"])

generated = env.Command(
  target=list(set(output_files)),
  source=[generator] + source_files,
  action=generate_native_dbcs,
)
