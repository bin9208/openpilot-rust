while IFS= read -r name; do run "quilt-$name" patch --directory="$native" --batch --fuzz=0 --no-backup-if-mismatch -p1 --input="$native/debian/patches/$name"; done < "$root/inputs/quilt.expected"
check_source() {
  printf '%s  %s\n' "$1" "$native/src/strace.c" "$2" "$native/src/syscall.c" \
    8073129838f921c5c0286c3c6cc0bebf7832b04f476340114ea25e5c8216c4a1 "$native/src/filter_seccomp.c" | sha256sum --check --strict --quiet -
}
check_source 21fe0b653612b9354ff783a9ca1643d39682d85fd38bf32a14b09cdea41febd1 0d8c5449b011a8cd16f0b5d0864f57fa633867876682270fee294390bb0e62b1
for item in observer inherited-filter; do
  patchfile=$source/tools/ci/fixtures/strace-6.8-560-$item.patch
  case $item in observer) digest=b32a9508ded464e5c08b22444064ba2de300b0373e0bce643974f4e21775d51a;; inherited-filter) digest=9091d941bd67823844a62f9aae4525eef019cb8f20486105caa9b4849193c0ca;; esac
