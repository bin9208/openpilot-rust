run original-elf /bin/bash -c 'set -euo pipefail; dpkg-deb --fsys-tarfile "$1" | tar -xOf - ./usr/bin/strace > "$2"' \
  original-strace "$root/inputs/strace_6.8-0ubuntu2_amd64.deb" "$root/inputs/ubuntu-strace.elf"
printf '%s  %s\n' 28f957c227012de0b18d1bd7fff2d396cb693ea60ed8013be68de071e84b5001 "$root/inputs/ubuntu-strace.elf" | sha256sum --check --strict --quiet -
run unpack-original tar -xJf "$root/inputs/strace_6.8.orig.tar.xz" -C "$root/source" --no-same-owner --no-same-permissions
native=$root/source/strace-6.8
run unpack-debian tar -xJf "$root/inputs/strace_6.8-0ubuntu2.debian.tar.xz" -C "$native" --no-same-owner --no-same-permissions
printf '02-disable_delay_test\n0007-XFAIL-netlink_crypto.patch\n0008-XFAIL-nlattr_crypto_user_alg.patch\nfix-time_t-conversion.patch\n' > "$root/inputs/quilt.expected"
