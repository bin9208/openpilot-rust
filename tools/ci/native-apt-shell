# Sourced only by a job-owned BASH_ENV on an admitted native runner. Original
# scripts remain intact; constrain their default APT view like a clean native VM.
# Explicit architecture/config/source options keep their original cross view.
if [[ ${OPENPILOT_CI_EXECUTION_MODE:-native} != qemu-user && ${LOCAL_CI_ARCH:-$(uname -m)} == "$(uname -m)" ]]; then
  sudo() {
    local -a apt_scope_original=("$@")
    local apt_scope_index=0 apt_scope_mode=native-default apt_scope_argument apt_scope_native
    if [[ ${apt_scope_original[0]:-} == -n ]]; then apt_scope_index=1; fi
    case ${apt_scope_original[apt_scope_index]:-} in
      apt-get|/usr/bin/apt-get) ;;
      *) /usr/bin/sudo "${apt_scope_original[@]}"; return ;;
    esac
    /usr/bin/python3 -I -B -S "$GITHUB_WORKSPACE/tools/ci/runner_policy.py" || return
    [[ ${CI_JOB_TEMP:-} == /tmp/openpilot-ci.* && ${CI_JOB_TEMP%/*} == /tmp && ! -L $CI_JOB_TEMP &&
       -f $CI_JOB_TEMP/owner && ! -L $CI_JOB_TEMP/owner &&
       $(cat "$CI_JOB_TEMP/owner") == "$GITHUB_RUN_ID:$GITHUB_RUN_ATTEMPT:$GITHUB_JOB" &&
       ${GITHUB_SHA:-} =~ ^[0-9a-f]{40}$ && ! -L $CI_JOB_TEMP/native-apt-evidence.jsonl ]] || {
      echo 'Job-owned native APT context required' >&2; return 1;
    }
    for apt_scope_argument in "${apt_scope_original[@]:apt_scope_index+1}"; do
      case ${apt_scope_argument,,} in
        -c|-c?*|--config-file|--config-file=*|*apt::architectur*|*dir::etc::source*) apt_scope_mode=explicit-configuration ;;
      esac
    done
    apt_scope_native=$(/usr/bin/dpkg --print-architecture)
    case "$(uname -m):$apt_scope_native" in
      x86_64:amd64|aarch64:arm64) ;;
      *) echo 'Native APT architecture differs from the actual host' >&2; return 1 ;;
    esac
    /usr/bin/python3 -I -B -S - "$CI_JOB_TEMP/native-apt-evidence.jsonl" "$apt_scope_mode" "$apt_scope_native" <<'PY_APT'
import json, os, platform, sys
with open(sys.argv[1], 'a') as stream:
    stream.write(json.dumps(dict(schema=1, mode=sys.argv[2], native_architecture=sys.argv[3],
        source_commit=os.environ['GITHUB_SHA'], runner_name=os.environ['RUNNER_NAME'],
        runner_environment=os.environ['RUNNER_ENVIRONMENT'], host_architecture=platform.machine(),
        target_architecture=os.environ.get('LOCAL_CI_ARCH', platform.machine()), execution_mode='native',
        shared_source_or_architecture_modified=False))+'\n')
PY_APT
    if [[ $apt_scope_mode == explicit-configuration ]]; then
      /usr/bin/sudo "${apt_scope_original[@]}"
    else
      /usr/bin/sudo "${apt_scope_original[@]:0:apt_scope_index}" "${apt_scope_original[apt_scope_index]}" \
        -oAPT::Architectures="$apt_scope_native" "${apt_scope_original[@]:apt_scope_index+1}"
    fi
  }
fi
