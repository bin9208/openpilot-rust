set(BUILD_SHARED_LIBS ON)
set(CV_ENABLE_INTRINSICS ON)
set(HAVE_INTTYPES_H OFF)
set(HAVE_JASPER ON)
set(HAVE_JPEG ON)
set(HAVE_PTHREAD ON)
set(HAVE_PTHREADS_PF ON)
set(OPENCV_TRACE ON)
set(OPENCV_MODULE_DEFINITIONS_CONFIGMAKE "")
foreach(module CORE DNN IMGCODECS IMGPROC VIDEOIO)
  string(APPEND OPENCV_MODULE_DEFINITIONS_CONFIGMAKE "#define HAVE_OPENCV_${module}\n")
endforeach()
string(APPEND OPENCV_MODULE_DEFINITIONS_CONFIGMAKE "\n")
foreach(header cvconfig.h opencv_modules.hpp)
  configure_file("${CMAKE_CURRENT_LIST_DIR}/source/cmake/templates/${header}.in" "${CMAKE_CURRENT_LIST_DIR}/install/include/opencv4/opencv2/${header}")
endforeach()
