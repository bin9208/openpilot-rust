#!/bin/sh
# Immutable transport observer: successful WAV generation is still performed by
# the actual native asset helper, never by this launcher.
set -eu
actual=$SOUNDD_REAL_ASSETS
witness=$SOUNDD_HELPER_STDIN_WITNESS
unset SOUNDD_REAL_ASSETS SOUNDD_HELPER_STDIN_WITNESS
IFS= read -r line
printf '%s\n' "$line" > "$witness"
exec "$actual" "$@"
