#!/bin/sh
# Immutable exec target. All mutable per-test state is private data, not a script.
set -eu
state=$VERSION_SLOW_GIT_STATE
count=0
if [ -f "$state/count" ]; then read -r count < "$state/count"; fi
count=$((count + 1))
printf '%s\n' "$count" > "$state/count"
/bin/sleep 20 >/dev/null 2>&1 &
sleeper=$!
if [ "${VERSION_SLOW_GIT_DIAGNOSTIC:-0}" = 1 ]; then
  printf 'raw Git diagnostic:\377\r\n' >&2
fi
printf '%s %s\n' "$$" "$sleeper" > "$state/call.$count"
while [ ! -f "$state/ack.$count" ]; do /bin/sleep 0.01; done
if [ "$VERSION_SLOW_GIT_MODE" = shared ] && [ "$count" = 1 ]; then
  kill "$sleeper"
  wait "$sleeper" 2>/dev/null || :
  exec "$VERSION_SLOW_GIT_REAL" "$@"
fi
wait "$sleeper"
exec "$VERSION_SLOW_GIT_REAL" "$@"
