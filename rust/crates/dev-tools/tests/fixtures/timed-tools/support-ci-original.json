{
  "provenance": {
    "workflow_sha256": "49f8deb405e4ea1922eac6976daae6742964f9a8f95f9b18186ccd3228da602a",
    "capture": "Exact pre-migration support-runtime shell lines, excluding only the eight timed checker CLI invocations. Existing apt prerequisites captured separately because strace is added for native regression scheduling."
  },
  "environment": {
    "CARGO_BUILD_JOBS": "2",
    "PYTHONPATH": "${{ github.workspace }}:${{ github.workspace }}/rust/tools"
  },
  "timeout_minutes": "30",
  "apt_packages": [
    "capnproto",
    "libcapnp-dev",
    "g++",
    "libzmq5"
  ],
  "command_lines": [
    "rustup toolchain install 1.94.0 --profile minimal",
    "python -m pip install numpy==2.5.3 pycapnp==2.1.0 Cython==3.2.4 setuptools==82.0.1 zstandard==0.25.0 pyzmq==27.2.0 requests==2.34.2 aiohttp==3.13.3 anyio==4.12.1 PyJWT==2.15.1 cryptography==50.0.1 pyserial==3.5",
    "printf 'PYTHONPATH=%s/support-msgq-python:%s\\n' \"$RUNNER_TEMP\" \"$PYTHONPATH\" >> \"$GITHUB_ENV\"",
    "cargo build --manifest-path rust/Cargo.toml -p openpilot-uploader -p openpilot-web-upload -p openpilot-dashcam-upload -p openpilot-params-typed -p openpilot-journald -p openpilot-timed -p openpilot-logmessaged --bins --examples --locked",
    "python rust/tools/build_msgq_python.py --output \"$RUNNER_TEMP/support-msgq-python\"",
    "python rust/tools/build_params_python.py --json11-stager \"$JSON11_STAGER\" --output \"$RUNNER_TEMP/support-params-binding\"",
    "python rust/tools/check_uploader.py --binary rust/target/debug/examples/uploader_trace --output \"$RUNNER_TEMP/support-runtime/uploader-reference/report.json\"",
    "python rust/tools/check_uploader_timeouts.py --binary rust/target/debug/examples/uploader_trace --output \"$RUNNER_TEMP/support-runtime/uploader-timeouts\"",
    "python rust/tools/check_web_upload.py --binary rust/target/debug/examples/web_upload_trace --output \"$RUNNER_TEMP/support-runtime/web-upload-reference\"",
    "python rust/tools/check_uploader_daemon.py --binary rust/target/debug/openpilot-uploader --output \"$RUNNER_TEMP/support-runtime/uploader-native\"",
    "python rust/tools/check_uploader_http_interrupted.py --binary rust/target/debug/openpilot-uploader --output \"$RUNNER_TEMP/support-runtime/uploader-http-interrupted\"",
    "python rust/tools/check_params_string.py --binding \"$RUNNER_TEMP\"/support-params-binding/params_pyx*.so \\",
    "--native rust/target/debug/examples/params_string_probe --output \"$RUNNER_TEMP/support-runtime/params-string\"",
    "python rust/tools/check_params_string_uploader.py --binding \"$RUNNER_TEMP\"/support-params-binding/params_pyx*.so \\",
    "--binary rust/target/debug/openpilot-uploader --collector rust/target/debug/openpilot-logmessaged --output \"$RUNNER_TEMP/support-runtime/params-uploader\"",
    "python rust/tools/check_logmessaged_startup.py --collector rust/target/debug/openpilot-logmessaged --output \"$RUNNER_TEMP/support-runtime/logmessaged-startup\"",
    "python rust/tools/check_uploader_logging.py --binary rust/target/debug/openpilot-uploader \\",
    "--trace rust/target/debug/examples/uploader_trace --collector rust/target/debug/openpilot-logmessaged --output \"$RUNNER_TEMP/support-runtime/uploader-logging\"",
    "python rust/tools/check_uploader_log_fault.py --native rust/target/debug/examples/uploader_log_fault \\",
    "--binding \"$RUNNER_TEMP\"/support-params-binding/params_pyx*.so --collector rust/target/debug/openpilot-logmessaged --output \"$RUNNER_TEMP/support-runtime/uploader-log-fault\"",
    "python rust/tools/check_dashcam_jobs.py --binary rust/target/debug/examples/dashcam_job_trace --output \"$RUNNER_TEMP/support-runtime/dashcam-jobs\"",
    "python rust/tools/check_dashcam_catalog.py --binary rust/target/debug/examples/dashcam_catalog_trace --output \"$RUNNER_TEMP/support-runtime/dashcam-catalog\"",
    "python rust/tools/check_dashcam_metadata.py --binary rust/target/debug/examples/dashcam_metadata_trace --output \"$RUNNER_TEMP/support-runtime/dashcam-metadata\"",
    "python rust/tools/check_dashcam_params.py --binary rust/target/debug/examples/dashcam_params_trace \\",
    "--binding \"$RUNNER_TEMP\"/support-params-binding/params_pyx*.so --output \"$RUNNER_TEMP/support-runtime/dashcam-params\"",
    "python rust/tools/check_dashcam_runtime.py --binary rust/target/debug/openpilot-dashcam-upload --output \"$RUNNER_TEMP/support-runtime/dashcam-runtime\"",
    "python rust/tools/check_dashcam_lifecycle.py --binary rust/target/debug/openpilot-dashcam-upload --output \"$RUNNER_TEMP/support-runtime/dashcam-lifecycle\"",
    "\"$GITHUB_WORKSPACE/rust/tools/check-disk-space\" --path \"$GITHUB_WORKSPACE\" --growth-mib 2048",
    "cargo +1.94.0 build --manifest-path rust/Cargo.toml -p openpilot-dev-tools --features journal-runtime-native --bin check-journald --bin journalctl-fixture --locked",
    "cargo +1.94.0 test --manifest-path rust/Cargo.toml -p openpilot-dev-tools --features journal-runtime-native --bin check-journald --test journald_check --test journald_fixture --test journald_runtime_check --locked",
    "rustup component add clippy --toolchain 1.94.0",
    "cargo +1.94.0 clippy --manifest-path rust/Cargo.toml -p openpilot-dev-tools --features journal-runtime-native --lib --bin check-journald --bin journalctl-fixture --test journald_check --test journald_fixture --test journald_runtime_check --locked -- -D warnings",
    "rust/target/debug/check-journald --binary rust/target/debug/journald-rs --fixture rust/target/debug/journalctl-fixture --output \"$RUNNER_TEMP/support-runtime/journald\"",
    "fault_root=\"$RUNNER_TEMP/support-runtime/interrupted-send\"",
    "mkdir -p \"$fault_root/bin\"",
    "gcc -Wall -Wextra -Werror -O2 -fPIC -DZMQ_LINK_WRAP -c rust/tools/zmq_send_boundary.c -o \"$fault_root/send-wrap.o\"",
    "gcc -Wall -Wextra -Werror -O2 -fPIC -shared rust/tools/zmq_send_boundary.c -ldl -o \"$fault_root/send-preload.so\"",
    "cargo rustc --manifest-path rust/Cargo.toml -p openpilot-logging --example logging_probe --locked -- -C link-arg=-Wl,--wrap=zmq_msg_send -C \"link-arg=$fault_root/send-wrap.o\"",
    "cp rust/target/debug/examples/logging_probe \"$fault_root/bin/\"",
    "cargo rustc --manifest-path rust/Cargo.toml -p openpilot-statsd --example stats_producer --locked -- -C link-arg=-Wl,--wrap=zmq_msg_send -C \"link-arg=$fault_root/send-wrap.o\"",
    "cp rust/target/debug/examples/stats_producer \"$fault_root/bin/\"",
    "cargo rustc --manifest-path rust/Cargo.toml -p openpilot-uploader --bin openpilot-uploader --locked -- -C link-arg=-Wl,--wrap=zmq_msg_send -C \"link-arg=$fault_root/send-wrap.o\"",
    "cp rust/target/debug/openpilot-uploader \"$fault_root/bin/\"",
    "python_zmq=\"$(python -c 'import pathlib, zmq; matches = list((pathlib.Path(zmq.__file__).parent.parent / \"pyzmq.libs\").glob(\"libzmq-*.so.*\")); assert len(matches) == 1, matches; print(matches[0])')\"",
    "python rust/tools/check_interrupted_send.py --logging \"$fault_root/bin/logging_probe\" --stats \"$fault_root/bin/stats_producer\" --preload \"$fault_root/send-preload.so\" --python-zmq \"$python_zmq\" --output \"$fault_root/producers\"",
    "python rust/tools/check_uploader_interrupted.py --binary \"$fault_root/bin/openpilot-uploader\" --output \"$fault_root/uploader\""
  ]
}
