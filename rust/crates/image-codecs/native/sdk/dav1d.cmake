# Decoder-only Linux C fallback for pinned dav1d 1.5.3. Replaces Meson's build
# orchestration, retaining upstream source/license. No Python or assembler.
include(CheckSymbolExists)
include(CheckIncludeFile)
set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
foreach(symbol posix_memalign aligned_alloc)
  string(TOUPPER ${symbol} upper)
  check_symbol_exists(${symbol} "stdlib.h" HAVE_${upper})
endforeach()
check_symbol_exists(memalign "malloc.h" HAVE_MEMALIGN)
check_symbol_exists(clock_gettime "time.h" HAVE_CLOCK_GETTIME)
check_symbol_exists(dlsym "dlfcn.h" HAVE_DLSYM)
foreach(symbol pthread_getaffinity_np pthread_setaffinity_np pthread_setname_np)
  string(TOUPPER ${symbol} upper)
  check_symbol_exists(${symbol} "pthread.h" HAVE_${upper})
endforeach()
check_symbol_exists(getauxval "sys/auxv.h" HAVE_GETAUXVAL)
foreach(header unistd.h sys/types.h)
  string(TOUPPER ${header} upper)
  string(REPLACE "/" "_" upper ${upper})
  string(REPLACE "." "_" upper ${upper})
  check_include_file(${header} HAVE_${upper})
endforeach()
file(WRITE "${CMAKE_BINARY_DIR}/dav1d-config/config.h" "#define CONFIG_8BPC 1\n#define CONFIG_16BPC 1\n#define CONFIG_LOG 1\n#define CONFIG_MACOS_KPERF 0\n#define TRIM_DSP_FUNCTIONS 0\n#define HAVE_ASM 0\n#define HAVE_C11_GENERIC 1\n#define ARCH_X86 0\n#define ARCH_X86_64 0\n#define ARCH_AARCH64 0\n#define ARCH_ARM 0\n#define ARCH_PPC64LE 0\n#define ARCH_RISCV 0\n#define ARCH_LOONGARCH 0\n#define HAVE_PTHREAD_NP_H 0\n#define HAVE_PTHREAD_SET_NAME_NP 0\n#define HAVE_ELF_AUX_INFO 0\n#define HAVE_IO_H 0\n#define ENDIANNESS_BIG 0\n")
foreach(symbol HAVE_POSIX_MEMALIGN HAVE_ALIGNED_ALLOC HAVE_MEMALIGN HAVE_CLOCK_GETTIME HAVE_DLSYM HAVE_PTHREAD_GETAFFINITY_NP HAVE_PTHREAD_SETAFFINITY_NP HAVE_PTHREAD_SETNAME_NP HAVE_GETAUXVAL HAVE_UNISTD_H HAVE_SYS_TYPES_H)
  if(${symbol})
    file(APPEND "${CMAKE_BINARY_DIR}/dav1d-config/config.h" "#define ${symbol} 1\n")
  else()
    file(APPEND "${CMAKE_BINARY_DIR}/dav1d-config/config.h" "#define ${symbol} 0\n")
  endif()
endforeach()
file(WRITE "${CMAKE_BINARY_DIR}/dav1d-config/vcs_version.h" "#define DAV1D_VERSION \"1.5.3\"\n")
set(dav1d_base cdf cpu ctx data decode dequant_tables getbits intra_edge itx_1d lf_mask lib log mem msac obu pal picture qm ref refmvs scan tables thread_task warpmv wedge)
set(dav1d_templates cdef_apply_tmpl cdef_tmpl fg_apply_tmpl filmgrain_tmpl ipred_prepare_tmpl ipred_tmpl itx_tmpl lf_apply_tmpl loopfilter_tmpl looprestoration_tmpl lr_apply_tmpl mc_tmpl recon_tmpl)
set(dav1d_files)
foreach(source ${dav1d_base})
  list(APPEND dav1d_files "${DAV1D_SOURCE}/src/${source}.c")
endforeach()
foreach(depth 8 16)
  set(tmpl_files)
  foreach(source ${dav1d_templates})
    list(APPEND tmpl_files "${DAV1D_SOURCE}/src/${source}.c")
  endforeach()
  add_library(dav1d_${depth} OBJECT ${tmpl_files})
  target_compile_definitions(dav1d_${depth} PRIVATE BITDEPTH=${depth} _GNU_SOURCE DAV1D_STATIC)
  target_include_directories(dav1d_${depth} PRIVATE "${DAV1D_SOURCE}" "${DAV1D_SOURCE}/include" "${DAV1D_SOURCE}/include/dav1d" "${CMAKE_BINARY_DIR}/dav1d-config")
endforeach()
add_library(dav1d STATIC ${dav1d_files} $<TARGET_OBJECTS:dav1d_8> $<TARGET_OBJECTS:dav1d_16>)
# libavif adds dl through this namespaced target, so it must be mutable
# (CMake rejects target_link_libraries on an alias).
set_target_properties(dav1d PROPERTIES ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
add_library(dav1d::dav1d STATIC IMPORTED GLOBAL)
set_target_properties(dav1d::dav1d PROPERTIES
  IMPORTED_LOCATION "${CMAKE_BINARY_DIR}/libdav1d.a"
  INTERFACE_INCLUDE_DIRECTORIES "${DAV1D_SOURCE}/include"
  INTERFACE_COMPILE_DEFINITIONS DAV1D_STATIC
  AVIF_LOCAL ON)
add_dependencies(dav1d::dav1d dav1d)
target_compile_definitions(dav1d PRIVATE _GNU_SOURCE PUBLIC DAV1D_STATIC)
target_include_directories(dav1d PRIVATE "${DAV1D_SOURCE}" "${DAV1D_SOURCE}/include/dav1d" "${CMAKE_BINARY_DIR}/dav1d-config" PUBLIC "${DAV1D_SOURCE}/include")
target_link_libraries(dav1d PRIVATE m pthread dl)
install(TARGETS dav1d ARCHIVE DESTINATION lib)
install(DIRECTORY "${DAV1D_SOURCE}/include/dav1d" DESTINATION include FILES_MATCHING PATTERN "*.h")
