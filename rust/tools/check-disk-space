#!/usr/bin/env bash
# CI bootstrap only: check operation growth before toolchain installation/build, then exec Rust.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
operation_path=.
growth_mib=
path_seen=false
growth_seen=false
fail() { printf 'disk space: %s\n' "$1" >&2; exit 1; }
arguments=("$@")
while (($#)); do
  case "$1" in
    --path)
      $path_seen && fail 'unknown or duplicate argument'
      (($# > 1)) || fail '--path needs a value'
      operation_path=$2; path_seen=true; shift ;;
    --growth-mib)
      $growth_seen && fail 'unknown or duplicate argument'
      (($# > 1)) || fail '--growth-mib needs a value'
      growth_mib=$2; growth_seen=true; shift ;;
    --help|-h) printf 'Usage: check-disk-space --path PATH --growth-mib NONNEGATIVE_INTEGER\n'; exit 0 ;;
    *) fail 'unknown or duplicate argument' ;;
  esac
  shift
done
$path_seen || fail '--path required'
$growth_seen || fail '--growth-mib required'
growth_mib=${growth_mib#+}
# GNU expr uses exact integers; do not overflow Bash's signed arithmetic.
if [[ ! $growth_mib =~ ^[0-9]+$ ]]; then
  printf 'disk space: invalid growth\n' >&2; exit 1
fi
growth_bytes=$(expr "$growth_mib" '*' 1048576) || test "$growth_bytes" = 0
required=$growth_bytes
if [[ $(expr "$required" '<=' 18446744073709551615) != 1 ]]; then
  printf 'disk space: growth exceeds u64\n' >&2; exit 1
fi
case $(uname -m) in
  x86_64) host=x86_64-unknown-linux-gnu ;;
  aarch64) host=aarch64-unknown-linux-gnu ;;
  *) printf 'disk space: unsupported bootstrap host\n' >&2; exit 1 ;;
esac
# Never execute a predictable cache entry before validating its ownership/type.
uid=$(id -u)
validate() {
  local path=$1 kind=$2 metadata owner mode
  [[ $path == /proc/$$/fd/9 || ! -L $path ]] || fail "unsafe cache symlink: $path"
  if [[ $kind == directory ]]; then [[ -d $path ]] || fail "cache is not a directory: $path"
  else [[ -f $path ]] || fail "cache is not a regular file: $path"; fi
  metadata=$(stat -Lc '%u %a' -- "$path")
  read -r owner mode <<< "$metadata"
  [[ $owner == "$uid" ]] || fail "cache owner differs: $path"
  (( (8#$mode & 0022) == 0 )) || fail "cache is group/world writable: $path"
}
validate_existing() {
  local path=$1 kind=$2
  if [[ -e $path || -L $path ]]; then validate "$path" "$kind"; fi
}
prepared=false
prepared_arm=false
[[ -z ${OPENPILOT_CI_PREPARED_RUST_MODE:-} || ${OPENPILOT_CI_PREPARED_RUST_MODE:-} == native-arm-530-v1 ]] || fail 'unknown prepared Rust mode'
[[ -z ${OPENPILOT_CI_PREPARED_RUST_MODE:-} || -n ${OPENPILOT_CI_PREPARED_RUST_ROOT:-} ]] || fail 'prepared Rust mode requires an SDK root'
if [[ -n ${OPENPILOT_CI_PREPARED_RUST_ROOT+x}${OPENPILOT_CI_PREPARED_RUST_MANIFEST+x} ]]; then
  prepared_root=${OPENPILOT_CI_PREPARED_RUST_ROOT:-}
  prepared_manifest=${OPENPILOT_CI_PREPARED_RUST_MANIFEST:-}
  [[ -n $prepared_root && -n $prepared_manifest ]] || fail 'prepared Rust root and manifest are both required'
  if [[ ${OPENPILOT_CI_PREPARED_RUST_MODE:-} == native-arm-530-v1 ]]; then
    [[ ${RUNNER_ENVIRONMENT:-}:${RUNNER_OS:-}:${RUNNER_ARCH:-} == github-hosted:Linux:ARM64 && $host == aarch64-unknown-linux-gnu ]] || fail 'prepared ARM host differs'
    [[ $prepared_root == "${CI_JOB_TEMP:?}/arm530-sdk/rustup-home/toolchains/1.94.0-aarch64-unknown-linux-gnu" &&
       $prepared_manifest == "$CI_JOB_TEMP/proof/arm530-sdk/sdk.before.sha256" ]] || fail 'prepared ARM root/manifest differs'
    case ${GITHUB_JOB:-} in
      planner-runtime|carrot-man-runtime|webrtc-runtime|webcam-runtime|xiaoge-runtime|radard-runtime|radar-arm|carrot-navi-arm) ;;
      *) fail 'unapproved prepared ARM role';;
    esac
    prepared_arm=true
  elif [[ ${RUNNER_ENVIRONMENT:-} == github-hosted ]]; then
    [[ ${GITHUB_ACTIONS:-} == true && ${GITHUB_REPOSITORY:-} == bin9208/openpilot-rust && ${RUNNER_OS:-} == Linux && ${RUNNER_ARCH:-} == X64 && $host == x86_64-unknown-linux-gnu ]] || fail 'prepared Rust requires trusted Linux X64 Actions'
    [[ ${CI_JOB_TEMP:-} == /tmp/openpilot-ci.?????? && ${CI_JOB_TEMP%/*} == /tmp ]] || fail 'prepared hosted job path differs'
    [[ $prepared_root == "$CI_JOB_TEMP/rustup-home/toolchains/1.94.0-x86_64-unknown-linux-gnu" && $prepared_manifest == "$CI_JOB_TEMP/proof/prepared-rust-files.before.sha256" ]] || fail 'unapproved private hosted Rust binding'
    validate "$CI_JOB_TEMP" directory
    validate "$CI_JOB_TEMP/owner" file
    [[ $(cat -- "$CI_JOB_TEMP/owner") == "${GITHUB_RUN_ID:?}:${GITHUB_RUN_ATTEMPT:?}:${GITHUB_JOB:?}" ]] || fail 'prepared hosted owner differs'
  else
    [[ $prepared_root == /home/actions/.rustup/toolchains/1.94.0-x86_64-unknown-linux-gnu ]] || fail 'unapproved prepared Rust root'
    [[ ${GITHUB_ACTIONS:-} == true && ${RUNNER_NAME:-} == bin-actions && ${RUNNER_OS:-} == Linux && ${RUNNER_ARCH:-} == X64 && $host == x86_64-unknown-linux-gnu ]] || fail 'prepared Rust requires bin-actions Linux X64 CI'
  fi
  [[ $prepared_manifest == /* ]] || fail 'prepared Rust manifest must be absolute'
  prepared=true
fi
validate_prepared() {
  if $prepared_arm; then
    [[ ${CI296_SOURCE:-} == "$root" ]] || fail 'prepared ARM source differs'
    /usr/bin/bash "$root/tools/ci/prepare-readonly-arm-rust-530" verify || fail 'prepared ARM SDK binding rejected'
    return
  fi
  local entry cargo_seen=false rustc_seen=false
  validate "$prepared_manifest" file
  [[ $(readlink -e -- "$prepared_manifest") == "$prepared_manifest" ]] || fail 'prepared Rust manifest must have a canonical nonsymlink path'
  # The parent supplies an SDK-wide sha256sum manifest with absolute file paths.
  # Check it even on the warm path; missing/broken SDKs must never trigger repair.
  sha256sum --check --strict --quiet -- "$prepared_manifest" >&2 || fail 'prepared Rust manifest checksum failed'
  while IFS= read -r entry || [[ -n $entry ]]; do
    [[ ${entry:0:64} =~ ^[[:xdigit:]]{64}$ ]] || continue
    case "${entry:64}" in
      "  $prepared_root/bin/cargo"|" *$prepared_root/bin/cargo") cargo_seen=true ;;
      "  $prepared_root/bin/rustc"|" *$prepared_root/bin/rustc") rustc_seen=true ;;
    esac
  done < "$prepared_manifest"
  $cargo_seen && $rustc_seen || fail 'prepared Rust manifest must cover absolute cargo and rustc paths'
  validate "$prepared_root" directory
  [[ $(readlink -e -- "$prepared_root") == "$prepared_root" ]] || fail 'prepared Rust root must have a canonical nonsymlink path'
  for entry in cargo rustc; do
    validate "$prepared_root/bin/$entry" file
    [[ -x $prepared_root/bin/$entry && $(readlink -e -- "$prepared_root/bin/$entry") == "$prepared_root/bin/$entry" ]] || fail "prepared Rust executable is missing or aliased: $entry"
  done
}
if $prepared; then validate_prepared; fi
identity=$(sha256sum "$root/rust/Cargo.toml" "$root/rust/Cargo.lock" "$root/rust/crates/disk-space/Cargo.toml" "$root/rust/crates/disk-space/src/"*.rs | sha256sum)
identity=${identity%% *}
cache_parent=${RUNNER_TEMP:-${XDG_CACHE_HOME:-$HOME/.cache}}
cache_base=$cache_parent/openpilot-disk-guard
cache=$cache_base/$host-$identity
binary=$cache/disk-space-guard
validate_existing "$cache_parent" directory
validate_existing "$cache_base" directory
validate_existing "$cache" directory
validate_existing "$cache_base/bootstrap.lock" file
validate_existing "$binary" file
if [[ -x $binary ]]; then exec "$binary" "${arguments[@]}"; fi
reserve() {
  local destination=$1 growth=$2 ancestor=$1 free needed
  while [[ ! -e $ancestor ]]; do ancestor=$(dirname -- "$ancestor"); done
  free=$(df -B1 --output=avail -- "$ancestor" | tail -n 1)
  free=${free//[[:space:]]/}
  [[ $free =~ ^[0-9]+$ ]] || { printf 'disk space: invalid df response\n' >&2; return 1; }
  needed=$growth
  if [[ $(expr "$free" '>=' "$needed") != 1 ]]; then
    printf '{"free_bytes":%s,"required_bytes":%s,"growth_bytes":%s}\n' "$free" "$needed" "$growth"
    printf 'disk space: insufficient disk: operation growth exceeds available space (%s)\n' "$destination" >&2
    return 1
  fi
}
# Operation filesystem may differ from toolchain/cache filesystems.
reserve "$operation_path" "$growth_bytes"
reserve "$cache_base" 1073741824
reserve "${RUSTUP_HOME:-$HOME/.rustup}" 1073741824
reserve "${CARGO_HOME:-$HOME/.cargo}" 1073741824
umask 077
mkdir -p -- "$cache_base"
validate "$cache_parent" directory
validate "$cache_base" directory
# RDWR opens an existing FIFO without waiting for a partner. Validate the
# opened descriptor before flock; the private parent excludes other users.
validate_existing "$cache_base/bootstrap.lock" file
exec 9<>"$cache_base/bootstrap.lock"
validate "/proc/$$/fd/9" file
flock 9
validate_existing "$cache" directory
validate_existing "$binary" file
if [[ ! -x $binary ]]; then
  # Recheck after waiting: another bootstrap may have consumed capacity.
  reserve "$operation_path" "$growth_bytes"
  reserve "$cache_base" 1073741824
  reserve "${RUSTUP_HOME:-$HOME/.rustup}" 1073741824
  reserve "${CARGO_HOME:-$HOME/.cargo}" 1073741824
  if $prepared; then
    # Recheck after the lock wait, then bypass every rustup shim/proxy.
    validate_prepared
    bootstrap_cargo=(env "RUSTC=$prepared_root/bin/rustc" "$prepared_root/bin/cargo")
  else
    rustup toolchain install 1.94.0 --profile minimal >&2
    bootstrap_cargo=(cargo +1.94.0)
  fi
  mkdir -p -- "$cache"
  env -u RUSTFLAGS -u CARGO_ENCODED_RUSTFLAGS -u CARGO_BUILD_TARGET -u RUSTC_WRAPPER -u RUSTC_WORKSPACE_WRAPPER \
    CARGO_INCREMENTAL=0 CARGO_BUILD_JOBS=2 "${bootstrap_cargo[@]}" build \
    --manifest-path "$root/rust/Cargo.toml" -p openpilot-disk-space --bin disk-space-guard \
    --locked --target "$host" --target-dir "$cache/build" >&2
  temporary=$(mktemp "$cache/.publish.XXXXXXXX")
  trap 'rm -f -- "$temporary"' EXIT
  cp -- "$cache/build/$host/debug/disk-space-guard" "$temporary"
  chmod 700 -- "$temporary"
  mv -f -- "$temporary" "$binary"
  trap - EXIT
fi
flock -u 9
exec 9>&-
exec "$binary" "${arguments[@]}"
