#include <sys/mman.h>
#include <sys/ioctl.h>
#include <unistd.h>
#include <fcntl.h>
#include <cassert>
#include <cerrno>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <functional>
#include <memory>
#include <map>
#include <queue>
#include <optional>
#include <iostream>
#include <media/cam_defs.h>
#include <media/cam_req_mgr.h>
#include <media/cam_sensor.h>
#include <media/cam_isp.h>
#include <media/cam_isp_ife.h>
#include <media/cam_icp.h>
#include "system/camerad/cameras/cdm.h"
#include "system/camerad/cameras/nv12_info.h"
#include "system/camerad/cameras/bps_blobs.h"
#include "system/camerad/sensors/sensor.h"
#define LOG(...) ((void)0)
#define LOGD(...) ((void)0)
#define LOGE(...) ((void)0)
#define LOGW(...) ((void)0)
#define ALIGNED_SIZE(x, align) (((x) + (align)-1) & ~((align)-1))
enum { ISP_RAW_OUTPUT = 0, ISP_IFE_PROCESSED = 1, ISP_BPS_PROCESSED = 2,
  CSLDeviceTypeIFE = 0x0f000000, OpcodesIFEUpdate = 1, OpcodesIFEInitialConfig = 0, CSLDeviceTypeBPS = 0x10000000 };
@HELPERS@
struct SpectraMaster {
  unique_fd video0_fd, cam_sync_fd, isp_fd, icp_fd;
  int device_iommu = 0x102, cdm_iommu = 0x304, icp_device_iommu = 0x506;
  MemoryManager mem_mgr;
};
@BUFFER@
struct CameraConfig { int output_type; bool vignetting_correction = true; uint32_t phy = 0x4001; int camera_num = 0; };
struct SensorRef {
  const SensorInfo *value;
  const SensorInfo *operator->() const { return value; }
  const SensorInfo *get() const { return value; }
};
struct SpectraCamera {
  SpectraMaster* m;
  CameraConfig cc;
  SensorRef sensor;
  bool enabled = true;
  int session_handle = 12, isp_dev_handle = -1, icp_dev_handle = -1, ife_buf_depth;
  struct { uint32_t out_img_width, out_img_height; } buf;
  uint32_t stride, y_height, uv_height, yuv_size, uv_offset;
  int buf_handle_raw[20] = {}, buf_handle_yuv[20] = {}, sync_objs_ife[20] = {}, sync_objs_bps[20] = {};
  SpectraBuf ife_cmd, ife_gamma_lut, ife_linearization_lut, ife_vignetting_lut;
  SpectraBuf bps_cmd, bps_cdm_buffer, bps_cdm_program_array, bps_cdm_striping_bl, bps_iq, bps_striping, bps_linearization_lut, bps_gamma_lut, bps_fullres_dummy;
  std::vector<uint32_t> bps_lin_reg, bps_ccm_reg;
  void configISP();
  void configICP();
  void config_ife(int, int, bool = false);
  void config_bps(int, int);
};
@IFE@
@METHODS@
int main(int argc, char** argv) {
  assert(argc == 4);
  AR0231 ar; OX03C10 ox; OS04C10 os;
  const SensorInfo* sensors[] = {&ar, &ox, &os};
  auto sensor = sensors[atoi(argv[1]) - 1];
  int mode = atoi(argv[2]), depth = atoi(argv[3]);
  SpectraMaster master;
  master.video0_fd = open("/dev/camera-fixture-request", O_RDWR | O_NONBLOCK);
  master.isp_fd = open("/dev/camera-fixture-isp", O_RDWR | O_NONBLOCK);
  master.icp_fd = open("/dev/camera-fixture-icp", O_RDWR | O_NONBLOCK);
  master.cam_sync_fd = open("/dev/camera-fixture-sync", O_RDWR | O_NONBLOCK);
  master.mem_mgr.init(master.video0_fd);
  SpectraCamera camera{.m=&master, .cc={mode}, .sensor={sensor}, .ife_buf_depth=depth};
  camera.buf.out_img_width = sensor->frame_width / sensor->out_scale;
  camera.buf.out_img_height = (sensor->hdr_offset > 0 ? (sensor->frame_height - sensor->hdr_offset) / 2 : sensor->frame_height) / sensor->out_scale;
  std::tie(camera.stride, camera.y_height, camera.uv_height, camera.yuv_size) = get_nv12_info(camera.buf.out_img_width, camera.buf.out_img_height);
  camera.uv_offset = camera.stride * camera.y_height;
  camera.configISP();
  if (mode == ISP_BPS_PROCESSED) camera.configICP();
  for (auto [slot, request] : std::vector<std::pair<int,int>>{{0,1},{depth-1,INT32_MIN+1},{0,INT32_MAX}}) {
    camera.buf_handle_raw[slot] = 200 + slot; camera.buf_handle_yuv[slot] = 300 + slot;
    camera.sync_objs_ife[slot] = 400 + slot; camera.sync_objs_bps[slot] = 500 + slot;
    camera.config_ife(slot, request);
    if (mode == ISP_BPS_PROCESSED) camera.config_bps(slot, request);
  }
  std::cout << "{\"isp\":" << camera.isp_dev_handle << ",\"bps\":";
  if (mode == ISP_BPS_PROCESSED) std::cout << camera.icp_dev_handle; else std::cout << "null";
  std::cout << "}\n";
  device_control(master.isp_fd, CAM_RELEASE_DEV, camera.session_handle, camera.isp_dev_handle);
  if (mode == ISP_BPS_PROCESSED) device_control(master.icp_fd, CAM_RELEASE_DEV, camera.session_handle, camera.icp_dev_handle);
}
