#!/usr/bin/env bash
# #530/#535: ephemeral GitHub 러너는 별도 SDK를 준비하고, 봉인 뒤에는 읽기 전용으로 재검증한다.
# Usage: prepare-readonly-ci-rust before|after (Fast의 소유 source/job/proof 환경 필수)
set -euo pipefail
umask 077
fail() { printf 'prepared CI Rust: %s\n' "$*" >&2; exit 1; }
[[ $# == 1 && ( $1 == before || $1 == after ) ]] || fail 'before or after required'
phase=$1
[[ ${GITHUB_ACTIONS:-} == true && ${GITHUB_REPOSITORY:-} == bin9208/openpilot-rust && ${RUNNER_OS:-} == Linux && ${RUNNER_ARCH:-} == X64 && $(uname -m) == x86_64 ]] || fail 'trusted Actions Linux/X64 CI required'
case ${RUNNER_ENVIRONMENT:-} in
  github-hosted) hosted=true ;;
  self-hosted) [[ ${RUNNER_NAME:-} == bin-actions ]] || fail 'unregistered legacy runner'; hosted=false ;;
  *) fail 'unknown runner environment' ;;
esac
uid=$(id -u)
validate() {
  local path=$1 kind=$2 owner mode
  [[ $path == /* && ! -L $path && $(readlink -e -- "$path") == "$path" ]] || fail 'canonical nonsymlink path required'
  if [[ $kind == directory ]]; then [[ -d $path ]] || fail 'directory required'
  else [[ -f $path ]] || fail 'regular file required'; fi
  read -r owner mode < <(stat -c '%u %a' -- "$path")
  [[ $owner == "$uid" ]] && (( (8#$mode & 0022) == 0 )) || fail 'owned path without shared write permission required'
}
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)
[[ $root == "${DIAG_SOURCE:?private source required}" && $root == "${GITHUB_WORKSPACE:?private workspace required}" ]] || fail 'private source binding differs'
validate "$root" directory
[[ ${GITHUB_SHA:-} =~ ^[0-9a-f]{40}$ && $(git -C "$root" rev-parse HEAD) == "$GITHUB_SHA" ]] || fail 'source SHA differs'
job=${CI_JOB_TEMP:?owned Fast temporary directory required}
[[ $job == /tmp/openpilot-ci.?????? && ${job%/*} == /tmp ]] || fail 'unexpected common job path'
validate "$job" directory
validate "$job/owner" file
[[ $(cat -- "$job/owner") == "${GITHUB_RUN_ID:?}:${GITHUB_RUN_ATTEMPT:?}:${GITHUB_JOB:?}" ]] || fail 'common job owner differs'
proof=$job/proof
validate "$proof" directory
if $hosted; then
  [[ ${RUSTUP_HOME:-} == "$job/rustup-home" && ${CARGO_HOME:-} == "$job/cargo-home" ]] || fail 'private hosted tool homes differ'
  sdk=$job/rustup-home/toolchains/1.94.0-x86_64-unknown-linux-gnu
  if [[ $phase == before ]]; then
    # 이 x64 집중 검사/docs에는 Android SDK가 필요 없다. job 전용 hosted VM에서만 회수한다.
    df -PB1 -- "$root" "$job" > "$proof/hosted-space-before.txt"
    df -Pi -- "$root" "$job" > "$proof/hosted-inodes-before.txt"
    printf 'name=%s\nenvironment=%s\nos=%s\narch=%s\nimage_os=%s\nimage_version=%s\n' "$RUNNER_NAME" "$RUNNER_ENVIRONMENT" "$RUNNER_OS" "$RUNNER_ARCH" "${ImageOS:-not-recorded}" "${ImageVersion:-not-recorded}" > "$proof/hosted-runner.txt"
    lscpu --json > "$proof/hosted-cpu.json"
    cat /etc/os-release > "$proof/hosted-os-release.txt"
    # python-android 등 다른 job은 SDK를 유지한다. 단순 Java/Gradle 작업도 Android 설정을 읽을 수 있다.
    android_unused=false
    case $GITHUB_JOB in focused|controls-normal40|setup-keys|check_user_docs|native) android_unused=true ;; esac
    printf 'job=%s\nandroid_sdk_unused=%s\n' "$GITHUB_JOB" "$android_unused" > "$proof/hosted-android-policy.txt"
    if $android_unused && [[ -e /usr/local/lib/android || -L /usr/local/lib/android ]]; then
      [[ -d /usr/local/lib/android && ! -L /usr/local/lib/android && $(readlink -e -- /usr/local/lib/android) == /usr/local/lib/android ]] || fail 'unexpected hosted Android SDK path'
      du -sx --block-size=1 -- /usr/local/lib/android > "$proof/unused-android-sdk-bytes.txt"
      sudo -n /usr/bin/timeout --signal=TERM --kill-after=10s 3m /usr/bin/rm -rf --one-file-system -- /usr/local/lib/android
      [[ ! -e /usr/local/lib/android && ! -L /usr/local/lib/android ]] || fail 'unused hosted Android SDK remains'
    fi
    df -PB1 -- "$root" "$job" > "$proof/hosted-space-after.txt"
    df -Pi -- "$root" "$job" > "$proof/hosted-inodes-after.txt"
    # Fast native의 실제 cold-bootstrap audit는 strace가 필요하다. 이미지에 없을 때만 준비한다.
    if [[ $GITHUB_JOB == native && ! -x /usr/bin/strace ]]; then
      available=$(df --output=avail -B1 -- / | tail -n 1)
      available=${available//[[:space:]]/}
      [[ $available =~ ^[0-9]+$ ]] || fail 'native proof package capacity unavailable'
      printf '{"available_bytes":%s,"planned_package_growth_bytes":1073741824}\n' "$available" > "$proof/hosted-native-package-admission.json"
      ((available >= 1024 * 1024 * 1024)) || fail 'insufficient native proof package growth'
      sudo -n /usr/bin/timeout --signal=TERM --kill-after=10s 3m apt-get -o APT::Architectures=amd64 update > "$proof/hosted-native-apt-update.log" 2>&1
      sudo -n /usr/bin/timeout --signal=TERM --kill-after=10s 3m apt-get -o APT::Architectures=amd64 install -y --no-install-recommends strace > "$proof/hosted-native-apt-install.log" 2>&1
      [[ -x /usr/bin/strace ]] || fail 'native proof strace unavailable'
    fi
  fi
  if [[ $phase == before && ! -e $sdk && ! -L $sdk ]]; then
    # SDK/다운로드/설치의 예상 증가량이다. source/build admission을 대신하지 않는다.
    available=$(df --output=avail -B1 -- "$job" | tail -n 1)
    available=${available//[[:space:]]/}
    [[ $available =~ ^[0-9]+$ ]] || fail 'SDK capacity unavailable'
    printf '{"available_bytes":%s,"planned_sdk_growth_bytes":3221225472}\n' "$available" > "$proof/hosted-sdk-admission.json"
    ((available >= 3 * 1024 * 1024 * 1024)) || fail 'insufficient hosted SDK growth'
    for path in "$RUSTUP_HOME" "$CARGO_HOME"; do
      if [[ -e $path || -L $path ]]; then validate "$path" directory; fi
    done
    mkdir -p -- "$RUSTUP_HOME" "$CARGO_HOME"
    validate "$RUSTUP_HOME" directory
    validate "$CARGO_HOME" directory
    bootstrap=$job/rust-bootstrap
    mkdir -- "$bootstrap"
    validate "$bootstrap" directory
    curl --proto '=https' --tlsv1.2 --fail --location --retry 3 --retry-all-errors \
      --max-time 300 --max-filesize 67108864 \
      https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init \
      --output "$bootstrap/rustup-init"
    printf '%s  %s\n' dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71 "$bootstrap/rustup-init" > "$proof/hosted-rustup.sha256"
    sha256sum --check --strict --quiet -- "$proof/hosted-rustup.sha256"
    chmod u+x -- "$bootstrap/rustup-init"
    timeout --signal=TERM --kill-after=10s 3m "$bootstrap/rustup-init" -y --default-toolchain none --no-modify-path
    timeout --signal=TERM --kill-after=10s 12m "$CARGO_HOME/bin/rustup" toolchain install 1.94.0 \
      --profile minimal --component rustfmt --component clippy > "$proof/hosted-sdk-install.stdout" 2> "$proof/hosted-sdk-install.stderr"
  fi
  printf '%s\n' "CI_PREPARED_RUSTUP_ROOT=$job/rustup-home" "CI_PREPARED_RUSTUP_BIN=$job/cargo-home/bin/rustup" >> "${GITHUB_ENV:?Actions environment required}"
else
  sdk=/home/actions/.rustup/toolchains/1.94.0-x86_64-unknown-linux-gnu
fi
validate "$sdk" directory
# SDK symlink/특수 파일/다른 소유자/공유 쓰기는 수리하지 않고 거절한다.
set -C
find "$sdk" \( ! -uid "$uid" -o \( ! -type d ! -type f \) -o -perm /0022 \) -print0 > "$proof/prepared-rust-rejected.$phase.bin"
[[ ! -s $proof/prepared-rust-rejected.$phase.bin ]] || fail 'SDK entries are not read-only owned regular files/directories'
programs=$proof/prepared-rust-programs.sha256
if [[ $phase == after ]]; then
  [[ ${CI_PREPARED_RUST_ROOT:-} == "$sdk" && ${CI_PREPARED_RUST_MANIFEST:-} == "$proof/prepared-rust-files.before.sha256" ]] || fail 'prepared environment binding differs'
  programs=$proof/prepared-rust-programs.after.sha256
fi
printf '%s  %s\n' 103b60e1b1339968c1d74202ea1d45686037e82c4ea3e0569de24b18a1e6836a "$sdk/bin/rustc" > "$programs"
printf '%s  %s\n' 77f14b761b02b47e6747473f556b3bc9f98f7e4525b7c3b8d74898ff816e4636 "$sdk/bin/cargo" >> "$programs"
printf '%s  %s\n' d1c6d8c0e2fae4fbb686d421415d2f471e409ade6babb3e491d9ac5d9c70c602 "$sdk/bin/rustfmt" >> "$programs"
printf '%s  %s\n' 2ff45d07196eec4f57a631103a877631d3579e86db2770bcfaa3b9d92a0b9d15 "$sdk/bin/clippy-driver" >> "$programs"
validate "$programs" file
for program in cargo rustc rustfmt clippy-driver rustdoc; do
  validate "$sdk/bin/$program" file
  [[ -x $sdk/bin/$program ]] || fail 'SDK executable missing'
done
sha256sum --check --strict --quiet -- "$programs"
LC_ALL=C find "$sdk" -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum > "$proof/prepared-rust-files.$phase.sha256"
LC_ALL=C find "$sdk" -printf '%D:%i\t%m:%U:%G\t%T@\t%C@\t%y\t%p\t%l\0' | LC_ALL=C sort -z > "$proof/prepared-rust-roster.$phase.bin"
if [[ $phase == before ]]; then
  "$sdk/bin/rustc" -vV > "$proof/prepared-rustc.txt"
  grep -Fx 'release: 1.94.0' "$proof/prepared-rustc.txt"
  grep -Fx 'host: x86_64-unknown-linux-gnu' "$proof/prepared-rustc.txt"
  "$sdk/bin/cargo" -V > "$proof/prepared-cargo.txt"
  printf '%s\n' "CI_PREPARED_RUST_ROOT=$sdk" "CI_PREPARED_RUST_MANIFEST=$proof/prepared-rust-files.before.sha256" "RUSTC=$sdk/bin/rustc" "RUSTDOC=$sdk/bin/rustdoc" >> "${GITHUB_ENV:?Actions environment required}"
  printf '%s\n' "$sdk/bin" >> "${GITHUB_PATH:?Actions path required}"
else
  validate "$proof/prepared-rust-programs.sha256" file
  validate "$proof/prepared-rust-files.before.sha256" file
  validate "$proof/prepared-rust-roster.before.bin" file
  cmp "$proof/prepared-rust-programs.sha256" "$proof/prepared-rust-programs.after.sha256"
  cmp "$proof/prepared-rust-files.before.sha256" "$proof/prepared-rust-files.after.sha256"
  cmp "$proof/prepared-rust-roster.before.bin" "$proof/prepared-rust-roster.after.bin"
fi
