* text=auto

# Large binaries stay in Git LFS to keep clones small.
*.onnx filter=lfs diff=lfs merge=lfs -text
selfdrive/car/tests/test_models_segs.txt filter=lfs diff=lfs merge=lfs -text
system/hardware/tici/updater filter=lfs diff=lfs merge=lfs -text

# Image / font / sound types are shipped as REAL blobs in this fork. Declaring
# them as LFS while the committed blob is real content made git-lfs report
# phantom "modified" files ("Encountered files that should have been pointers,
# but weren't") and blocked git pull on agnos. So they are NOT LFS by type.
# -text also keeps them out of EOL renormalization.
*.svg -filter -diff -merge -text
*.png -filter -diff -merge -text
*.gif -filter -diff -merge -text
*.ttf -filter -diff -merge -text
*.otf -filter -diff -merge -text
*.wav -filter -diff -merge -text

# The few assets that ARE stored as LFS pointers must stay LFS, otherwise the
# pointer text would be checked out as the file. These override the type rules
# above (more specific path wins).
docs/assets/comma-logo.png filter=lfs diff=lfs merge=lfs -text
openpilot/tools/cabana/assets/cabana-icon.png filter=lfs diff=lfs merge=lfs -text
openpilot/selfdrive/carrot/web/assets/alert_camera.svg filter=lfs diff=lfs merge=lfs -text
openpilot/selfdrive/carrot/web/assets/alert_police.svg filter=lfs diff=lfs merge=lfs -text

# dmonitoring model was already shipped as a real blob (supercombo stays LFS).
openpilot/selfdrive/modeld/models/dmonitoring_model.onnx -filter -diff -merge -text

# Original services.py script output includes a second terminal newline.
rust/crates/dev-tools/tests/fixtures/native-build-closure/services-script.h -text whitespace=-blank-at-eof

# Encoded decoder fixtures retain original bytes, including FITS/EPS padding.
rust/crates/dev-tools/tests/fixtures/image-array/*.image -text -diff
# Preserve verbatim upstream license bytes, including original whitespace.
rust/crates/image-codecs/native/licenses/libtiff -text whitespace=-trailing-space
rust/crates/image-codecs/native/licenses/openjpeg -text whitespace=-trailing-space
rust/crates/image-codecs/native/licenses/xz -text whitespace=-blank-at-eof

# Captured schema bytes are SHA-bound to the original runtime checker inputs.
rust/crates/dev-tools/tests/fixtures/camera-runtime-check/schema/car.capnp -text whitespace=-trailing-space

# Empty captured process titles are real trailing TSV fields, not padding.
rust/crates/process-limits/tests/fixtures/source-title-original.tsv -text whitespace=-blank-at-eol

# Independent model observations retain exact captured bytes and sealed hashes.
rust/crates/dev-tools/tests/fixtures/model-family-original/** -text
# The NAS installed marker was captured with CRLF, which its SHA includes.
rust/crates/dev-tools/tests/fixtures/model-family-original/usbgpu/original/capture-evidence/installed.json whitespace=cr-at-eol
# Captured empty values include their original space after the field label.
rust/crates/dev-tools/tests/fixtures/model-family-original/startup/original/*/native.log whitespace=-blank-at-eol
rust/crates/carrot-recovery/tests/fixtures/recovery-webhook-original/message-*/source.txt -text whitespace=-blank-at-eol
# Fresh original generator source is fixed oracle data, never reformatted input.
rust/crates/dev-tools/tests/fixtures/kalman-generators-original/** -text
